import '../db-declaration';

datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

plugin openapi {
    provider = "@zenstackhq/openapi"
    output = "../../static/openapi.yaml"
    title = "Snapp"
    version = "0.9-rc-006"
    prefix='/api'
    securitySchemes = {
        bearer: { type: 'http', scheme: 'bearer', bearerFormat: 'JWT' },
    }
}

plugin zod {
    provider = '@core/zod'
}

plugin enhancer {
    provider = '@core/enhancer'
    generatePermissionChecker = true
}