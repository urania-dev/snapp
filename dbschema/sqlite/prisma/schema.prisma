// This file is automatically generated by ZenStack CLI and should not be manually updated. //
//////////////////////////////////////////////////////////////////////////////////////////////

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id() @default(cuid())
  email     String    @unique()
  username  String    @unique()
  password  String
  notes     String?
  role      String    @default("user")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt()
  tfs       String?
  verified  Boolean   @default(false)
  snapps    Snapp[]
  sessions  Session[]
  settings  Setting[]
  token     Token[]
  usages    Usage[]
  groups    Group[]   @relation("membership")

  @@map("users")
}

model Session {
  id        String   @id()
  userId    String
  expiresAt DateTime
  tfs       Boolean  @default(false)
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("sessions")
}

model PasswordReset {
  tokenHash String   @unique()
  userId    String   @id()
  expiresAt DateTime

  @@map("passwordresets")
}

model Setting {
  id      String   @id() @unique() @default(cuid())
  field   String
  value   String
  userId  String?
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  created DateTime @default(now())

  @@index([field])
  @@index([field, userId])
  @@index([userId])
  @@map("settings")
}

model Token {
  key       String   @id()
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("token")
}

model Snapp {
  id          String    @id() @default(cuid())
  shortcode   String    @unique()
  originalUrl String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  disabled    Boolean   @default(false)
  userId      String
  groupId     String?
  utmParams   String?   @default("[]")
  secret      String?
  maxUsages   Int       @default(-1)
  hit         Int       @default(0)
  used        Int       @default(0)
  notes       String?
  tag         Tag[]     @relation("snapptags")
  usages      Usage[]
  user        User      @relation(fields: [userId], references: [id])
  group       Group?    @relation("publishedOnGroup", fields: [groupId], references: [slug])

  @@map("snapps")
}

model Usage {
  id        Int      @id() @default(autoincrement())
  timestamp DateTime @default(now())
  snappId   String
  ownerId   String
  language  String?
  userAgent String?
  referrer  String?
  device    String?
  country   String?
  region    String?
  city      String?
  os        String?
  browser   String?
  cpu       String?
  user      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  snapp     Snapp    @relation(fields: [snappId], references: [id], onDelete: Cascade)

  @@map("usages")
}

model Tag {
  name   String  @id() @unique()
  slug   String  @unique()
  notes  String?
  snapps Snapp[] @relation("snapptags")

  @@map("tags")
}

model Group {
  name   String  @unique()
  slug   String  @id() @unique()
  notes  String?
  users  User[]  @relation("membership")
  snapps Snapp[] @relation("publishedOnGroup")

  @@map("groups")
}

model VtApiCache {
  id        String   @id() @default(cuid())
  createdAt DateTime @default(now())
  domain    String   @unique()
  result    String

  @@map("vtapicaches")
}

model WatchList {
  id        String   @id() @default(cuid())
  createdAt DateTime @default(now())
  username  String?
  domain    String?
  allowed   Boolean

  @@map("watchlists")
}
