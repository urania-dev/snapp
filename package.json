		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:push": "bunx prisma db push --schema dbschema/sqlite/prisma/schema.prisma",
		"db:generate": "bunx zenstack generate --schema dbschema/sqlite/schema.zmodel"
	},
